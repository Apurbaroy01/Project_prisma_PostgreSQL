enum ACTIVESTATUS {
    ACTIVE
    BLOCKED
}

enum ROLE {
    USER
    ADMIN
    AUTHOR
}

model User {
    id           String       @id @default(uuid())
    name         String       @db.VarChar(50)
    email        String       @unique
    password      String
    activeStatus ACTIVESTATUS @default(ACTIVE)
    role         ROLE         @default(USER)
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @default(now())
    profile      Profile?

    @@map("users")
}
